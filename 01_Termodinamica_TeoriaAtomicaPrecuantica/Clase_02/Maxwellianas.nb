1dc40216d37d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"PM", "[", 
   RowBox[{"v_", ",", "m_", ",", "\[Tau]_"}], "]"}], ":=", 
  RowBox[{"4", "\[Pi]", 
   SuperscriptBox[
    RowBox[{"(", 
     FractionBox["m", 
      RowBox[{"2", "\[Pi]", " ", "\[Tau]"}]], ")"}], 
    RowBox[{"3", "/", "2"}]], 
   RowBox[{"Exp", "[", 
    RowBox[{"-", 
     FractionBox[
      RowBox[{"m", " ", 
       SuperscriptBox["v", "2"]}], 
      RowBox[{"2", "\[Tau]"}]]}], "]"}], 
   SuperscriptBox["v", "2"]}]}]], "Input",
