Cell["Distribuci\[OAcute]n de Maxwell para la rapidez", "Text",
 CellChangeTimes->{{3.839960710402974*^9, 3.839960733999324*^9}, {
  3.9884751792826176`*^9, 
  3.9884751851456375`*^9}},ExpressionUUID->"7d96a63f-fe32-4c37-a2fd-\
096652162a5e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"PM", "[", "v_", "]"}], ":=", 
  RowBox[{"4", "\[Pi]", 
   SuperscriptBox[
    RowBox[{"(", 
     FractionBox["m", 
      RowBox[{"2", "\[Pi]", " ", "k", " ", "T"}]], ")"}], 
    RowBox[{"3", "/", "2"}]], 
   RowBox[{"Exp", "[", 
    RowBox[{"-", 
     FractionBox[
      RowBox[{"m", " ", 
       SuperscriptBox["v", "2"]}], 
      RowBox[{"2", "k", " ", "T"}]]}], "]"}], 
   SuperscriptBox["v", "2"]}]}]], "Input",
 CellChangeTimes->{{3.813251176281432*^9, 3.813251222561079*^9}},
 CellLabel->"In[2]:=",ExpressionUUID->"c730edb2-5cd3-42ea-aaa0-b0f5806f7a12"],

