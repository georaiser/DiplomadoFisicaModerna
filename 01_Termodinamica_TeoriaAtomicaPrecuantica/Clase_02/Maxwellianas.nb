Cell[TextData[{
 "Raiz cuadr\[AAcute]tica media ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Sqrt", "[", 
    RowBox[{"<", 
     SuperscriptBox["v", "2"]}]}], TraditionalForm]],ExpressionUUID->
  "18c8185e-9f57-4991-bc73-d6fde4abbfae"],
 ">]"
}], "Text",
 CellChangeTimes->{{3.8399617010596366`*^9, 3.8399617372767076`*^9}, {
  3.988475266101385*^9, 
  3.9884752736394253`*^9}},ExpressionUUID->"3d7147c3-a2c7-4eba-9026-\
c61617c6d59e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{
        SuperscriptBox["v", "2"], " ", 
        RowBox[{"PM", "[", 
         RowBox[{"v", ",", "m", ",", "\[Tau]"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"v", ",", "0", ",", "Infinity"}], "}"}]}], "]"}], ")"}], 
    RowBox[{"1", "/", "2"}]], "//", "Simplify"}], "//", "Refine"}]], "Input",
 CellChangeTimes->{{3.839961775221878*^9, 3.839961806647676*^9}},
 CellLabel->"In[11]:=",ExpressionUUID->"5de08ad1-45de-4fed-b37d-62fcebba7cd8"],

Cell[BoxData[
 RowBox[{
  SqrtBox["3"], " ", 
  SqrtBox[
   FractionBox["\[Tau]", "m"]]}]], "Output",
 CellChangeTimes->{{3.839961781789254*^9, 3.8399617920438404`*^9}, 
   3.8399618469079785`*^9, 3.988475163333557*^9},
 CellLabel->"Out[11]=",ExpressionUUID->"60ffc731-5d32-ea4b-81e7-951bf851f67a"]
}, Open  ]],

Cell[TextData[{
 "Las tres velocidades caracter\[IAcute]sticas vmax, <v>, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Sqrt]", 
    RowBox[{"(", 
     RowBox[{"<", 
      SuperscriptBox["v", "2"]}]}]}], TraditionalForm]],ExpressionUUID->
  "bea89af6-7f71-4972-94ce-47fece2e33cf"],
 ">) son del mismo orden, pues van como  la raiz cuadrada de la temperatura ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", "T", ")"}], 
    RowBox[{"1", "/", "2"}]], TraditionalForm]],ExpressionUUID->
  "556f3a08-e8d1-4ebb-bec0-37cba5ae7789"],
 " \n"
}], "Text",
