Cell[BoxData[
 RowBox[{"-", 
  FractionBox[
   RowBox[{
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"-", 
      FractionBox[
       RowBox[{"m", " ", 
        SuperscriptBox["v", "2"]}], 
       RowBox[{"2", " ", "\[Tau]"}]]}]], " ", 
    SuperscriptBox["m", 
     RowBox[{"3", "/", "2"}]], " ", 
    SqrtBox[
     FractionBox["2", "\[Pi]"]], " ", "v", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"m", " ", 
       SuperscriptBox["v", "2"]}], "-", 
      RowBox[{"2", " ", "\[Tau]"}]}], ")"}]}], 
   SuperscriptBox["\[Tau]", 
    RowBox[{"5", "/", "2"}]]]}]], "Output",
