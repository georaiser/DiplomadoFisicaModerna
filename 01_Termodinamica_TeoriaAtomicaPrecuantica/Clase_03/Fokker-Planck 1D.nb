Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"EFP", "=", 
  RowBox[{
   RowBox[{"D", "[", 
    RowBox[{
     RowBox[{"f", "[", 
      RowBox[{"t", ",", "x"}], "]"}], ",", "t"}], "]"}], "+", 
   RowBox[{"\[Mu]", " ", 
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"f", "[", 
       RowBox[{"t", ",", "x"}], "]"}], ",", "x"}], "]"}]}], "-", 
   RowBox[{"Dif", " ", 
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"f", "[", 
       RowBox[{"t", ",", "x"}], "]"}], ",", "x", ",", "x"}], 
     "]"}]}]}]}]], "Input",
