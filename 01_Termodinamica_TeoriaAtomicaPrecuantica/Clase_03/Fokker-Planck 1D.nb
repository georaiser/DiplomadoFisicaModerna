Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", 
   RowBox[{"t_", ",", "x_"}], "]"}], "=", 
  RowBox[{
   FractionBox["1", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"4", "\[Pi]", " ", "d", " ", "t"}], ")"}], 
     RowBox[{"1", "/", "2"}]]], 
   RowBox[{"Exp", "[", 
    FractionBox[
     RowBox[{"-", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"x", "-", "x0", "-", 
         RowBox[{"\[Nu]", " ", "t"}]}], ")"}], "2"]}], 
     RowBox[{"4", " ", "d", " ", "t"}]], "]"}]}]}]], "Input",
 CellLabel->"In[2]:=",ExpressionUUID->"cd35c664-ad8d-48ac-9e93-49e58f305e1c"],

Cell[BoxData[
 FractionBox[
  SuperscriptBox["\[ExponentialE]", 
   RowBox[{"-", 
    FractionBox[
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "-", "t", "+", "x"}], ")"}], "2"], 
     RowBox[{"4", " ", "t"}]]}]], 
  RowBox[{"2", " ", 
   SqrtBox["\[Pi]"], " ", 
   SqrtBox["t"]}]]], "Output",
 CellChangeTimes->{3.901404387487248*^9},
 CellLabel->"Out[2]=",ExpressionUUID->"78bfc72c-5786-4fad-be3f-7004f6075cde"]
}, Open  ]],

